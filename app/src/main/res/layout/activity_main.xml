<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Logo / Icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="🛡️"
            android:textSize="80sp"
            android:gravity="center"/>

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Check Phone"
            android:textColor="#58A6FF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="فاحص أمان جهازك"
            android:textColor="#8B949E"
            android:textSize="16sp"/>

        <!-- Divider -->
        <View
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:layout_marginTop="24dp"
            android:background="#58A6FF"/>

        <!-- Features Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="#161B22"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ماذا يفحص التطبيق؟"
                    android:textColor="#C9D1D9"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔍  تطبيقات التجسس المعروفة" android:textColor="#8B949E" android:textSize="14sp" android:layout_marginBottom="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔐  الصلاحيات الخطيرة" android:textColor="#8B949E" android:textSize="14sp" android:layout_marginBottom="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="♿  خدمات إمكانية الوصول" android:textColor="#8B949E" android:textSize="14sp" android:layout_marginBottom="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⚙️  تطبيقات إدارة الجهاز" android:textColor="#8B949E" android:textSize="14sp" android:layout_marginBottom="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🌐  الشبكة واتصالات VPN" android:textColor="#8B949E" android:textSize="14sp" android:layout_marginBottom="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📦  التطبيقات من مصادر مجهولة" android:textColor="#8B949E" android:textSize="14sp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Scan Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:text="ابدأ الفحص الآن"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#238636"
            app:cornerRadius="12dp"/>

        <!-- About Button -->
        <TextView
            android:id="@+id/btnAbout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="عن التطبيق"
            android:textColor="#58A6FF"
            android:textSize="14sp"
            android:padding="8dp"/>

        <!-- About Card (hidden by default) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="#161B22"
            app:cardCornerRadius="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Check Phone يفحص جهازك بحثاً عن علامات الاختراق والتجسس.\n\nالتطبيق لا يرسل أي بيانات خارج جهازك.\nكل الفحص يتم محلياً بشكل كامل.\n\nالإصدار 1.0"
                android:textColor="#8B949E"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.5"/>
        </androidx.cardview.widget.CardView>

        <View android:layout_width="match_parent" android:layout_height="32dp"/>

    </LinearLayout>
</ScrollView>
